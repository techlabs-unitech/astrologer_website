# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay (Dashboard → Settings → API Keys). Use rzp_test_* while testing ─
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret (Dashboard → Settings → Webhooks). Recommended.
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ── Auto-translate product text to Kannada + Telugu (optional) ──────────────
# Google Cloud Console → enable "Cloud Translation API" → create an API key.
# If omitted, products show in English unless you type the translations manually.
GOOGLE_TRANSLATE_API_KEY=

NEXT_PUBLIC_SITE_URL=https://your-domain.com
